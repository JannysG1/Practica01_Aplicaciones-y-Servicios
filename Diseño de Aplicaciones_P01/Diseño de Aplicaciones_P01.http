@HostAddress = http://localhost:5214

### ====================================================================
### PRÁCTICA 03: 4.- ASP.NET CORE IDENTITY CON JWT
### ====================================================================

### 1. Login con Admin usando Nombre de Usuario (admin / Admin123) -> 200 OK
# @name loginAdmin
POST {{HostAddress}}/api/Auth/login
Content-Type: application/json

{
  "usuario": "admin",
  "password": "Admin123"
}

### Guardar token de Admin
@tokenAdmin = {{loginAdmin.response.body.token}}

### 2. Login con Admin usando Correo Electrónico (admin@cafeteria.com / Admin123) -> 200 OK
# @name loginAdminEmail
POST {{HostAddress}}/api/Auth/login
Content-Type: application/json

{
  "usuario": "admin@cafeteria.com",
  "password": "Admin123"
}

### 3. Login con credenciales antiguas (admin / 1234) -> 401 Unauthorized (usuarios fijos ya no existen)
POST {{HostAddress}}/api/Auth/login
Content-Type: application/json

{
  "usuario": "admin",
  "password": "1234"
}

### 4. Registro de nuevo usuario (cliente1 / Cliente123) -> 200 OK
# @name registerCliente
POST {{HostAddress}}/api/Auth/register
Content-Type: application/json

{
  "usuario": "cliente1",
  "email": "cliente1@cafeteria.com",
  "password": "Cliente123",
  "nombreCompleto": "Cliente de Prueba 1"
}

### 5. Registro con contraseña débil (1234) -> 400 Bad Request (reglas de contraseña incumplidas)
POST {{HostAddress}}/api/Auth/register
Content-Type: application/json

{
  "usuario": "cliente_debil",
  "email": "debil@cafeteria.com",
  "password": "1234",
  "nombreCompleto": "Usuario Débil"
}

### 6. Registro con correo o usuario repetido -> 400 Bad Request
POST {{HostAddress}}/api/Auth/register
Content-Type: application/json

{
  "usuario": "cliente1",
  "email": "cliente1@cafeteria.com",
  "password": "Cliente123",
  "nombreCompleto": "Usuario Duplicado"
}

### 7. Login con nuevo usuario registrado (cliente1 / Cliente123) -> 200 OK (Rol: Usuario)
# @name loginCliente
POST {{HostAddress}}/api/Auth/login
Content-Type: application/json

{
  "usuario": "cliente1",
  "password": "Cliente123"
}

### Guardar token de Cliente
@tokenCliente = {{loginCliente.response.body.token}}

### ====================================================================
### PRUEBAS DE PRODUCTOS Y CONTROL DE ACCESO BASADO EN ROLES (RBAC)
### ====================================================================

### 8. GET Productos con Cliente (Rol: Usuario) -> 200 OK (Acceso permitido)
GET {{HostAddress}}/api/Productos
Authorization: Bearer {{tokenCliente}}
Accept: application/json

### 9. POST Crear Producto con Cliente (Rol: Usuario) -> 403 Forbidden (Solo Admin)
POST {{HostAddress}}/api/Productos
Authorization: Bearer {{tokenCliente}}
Content-Type: application/json

{
  "nombre": "Capuchino Prohibido",
  "precio": 3.50,
  "activo": true
}

### 10. GET Productos con Admin (Rol: Admin) -> 200 OK
GET {{HostAddress}}/api/Productos
Authorization: Bearer {{tokenAdmin}}
Accept: application/json

### 11. POST Crear Producto con Admin (Rol: Admin) -> 201 Created
# @name crearProducto
POST {{HostAddress}}/api/Productos
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{
  "nombre": "Café Moca Especial",
  "precio": 3.75,
  "activo": true
}

### Guardar id del producto creado
@productoId = {{crearProducto.response.body.id}}

### 12. GET Producto por Id con Admin -> 200 OK
GET {{HostAddress}}/api/Productos/{{productoId}}
Authorization: Bearer {{tokenAdmin}}
Accept: application/json

### 13. PUT Actualizar Producto con Admin -> 204 No Content
PUT {{HostAddress}}/api/Productos/{{productoId}}
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{
  "nombre": "Café Moca Supremo",
  "precio": 4.00,
  "activo": true
}

### 14. DELETE Producto con Cliente (Rol: Usuario) -> 403 Forbidden
DELETE {{HostAddress}}/api/Productos/{{productoId}}
Authorization: Bearer {{tokenCliente}}

### 15. DELETE Producto con Admin (Rol: Admin) -> 204 No Content
DELETE {{HostAddress}}/api/Productos/{{productoId}}
Authorization: Bearer {{tokenAdmin}}

### ====================================================================
### EXAMEN PRÁCTICO CORTO: PPP04 - PROVEEDORES (ADMIN PROTEGIDO)
### ====================================================================

### 16. Login Admin (admin / 1234) -> 200 OK
# @name loginAdminExamen
POST {{HostAddress}}/api/Auth/login
Content-Type: application/json

{
  "usuario": "admin",
  "password": "1234"
}

### Guardar token obtenido para examen
@tokenAdminExamen = {{loginAdminExamen.response.body.token}}

### 17. POST Proveedores sin autenticación -> 401 Unauthorized
POST {{HostAddress}}/api/Proveedores
Content-Type: application/json

{
  "nombre": "Distribuidora La Costa",
  "telefono": "0991234567",
  "activo": true
}

### 18. POST Proveedores con Cliente (Rol: Usuario) -> 403 Forbidden
POST {{HostAddress}}/api/Proveedores
Authorization: Bearer {{tokenCliente}}
Content-Type: application/json

{
  "nombre": "Distribuidora La Costa",
  "telefono": "0991234567",
  "activo": true
}

### 19. POST Proveedores con Admin (Guion de Prueba) -> 201 Created
POST {{HostAddress}}/api/Proveedores
Authorization: Bearer {{tokenAdminExamen}}
Content-Type: application/json

{
  "nombre": "Distribuidora La Costa",
  "telefono": "0991234567",
  "activo": true
}

